{
  "extends": "../web/tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "baseUrl": "./",
    "paths": {
      "@/lib/calculation/*": ["../web/lib/calculation/*"],
      "@/types/*": ["../web/types/*"]
    },
    "types": ["cypress", "node"]
  },
  "include": [
    "unit/**/*.ts",
    "cypress/**/*.ts",
    "cypress.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}